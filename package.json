{
  "name": "siya",
  "productName": "SIYA",
  "description": "SIYA — a private 3D AI desktop companion powered by each user's own Gemini API key.",
  "author": "SIYA",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:frontend": "tsc --noEmit -p tsconfig.app.json",
    "typecheck:mobile": "tsc --noEmit -p tsconfig.mobile.json",
    "dev": "vite",
    "build": "vite build && npm run build:server",
    "build:mobile-app": "vite build --config vite.mobile.config.ts",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --target=node18 --outfile=dist/server.cjs --external:express --external:ws --external:dotenv --external:@google/genai --external:vite --sourcemap",
    "start": "electron .",
    "test": "node --import tsx --test scripts/test_*.mjs",
    "package": "npm run build && electron-builder --config electron-builder.config.cjs --publish never"
  },
  "dependencies": {
    "@google/genai": "2.8.0",
    "@mediapipe/tasks-vision": "^1.0.1",
    "dotenv": "^17.2.3",
    "electron-updater": "^6.8.9",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "mmd-parser": "^1.0.4",
    "motion": "^12.23.24",
    "react": "19.0.1",
    "react-dom": "19.0.1",
    "three": "0.180.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "22.19.20",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.2.3"
  }
}
