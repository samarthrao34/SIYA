# Copy to mobile/app/.env before `npm run build:mobile`. Never commit .env.
# Both values are baked into the APK at build time, so treat the APK itself
# as private too and do not publish it.

# Your private memory server, e.g. http://<tailscale-ip>:<port>
VITE_SIYA_MEMORY_URL=
# Bearer token for that server
VITE_SIYA_BRAIN_TOKEN=
