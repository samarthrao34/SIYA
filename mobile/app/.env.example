# Copy to mobile/app/.env before `npm run build:mobile`. Never commit .env.
# Everything here is compiled into the APK, so it must never hold a secret.

# The memory gateway on your memory-server host (services/memory_gateway),
# e.g. http://<tailnet-ip>:20142. The gateway identifies this phone by its
# Tailscale device; no token is configured on the phone.
VITE_SIYA_MEMORY_URL=
