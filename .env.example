# Copy to .env for development runs (`npm run dev`). Every value is optional:
# the Gemini key can also be entered in the app's Settings panel, and the
# packaged desktop app stores it in its own per-user data folder instead.

# Google Gemini API key used for the live voice/vision session.
GEMINI_API_KEY=

# Which brain drives conversation: "gemini" (default) or "local"
# (Gemma via LiteRT-LM + the offline voice service in services/local_voice).
# SIYA_BRAIN=gemini

# Local brain endpoints (only used when SIYA_BRAIN=local)
# SIYA_LOCAL_LLM_URL=http://127.0.0.1:9379/v1
# SIYA_LOCAL_MODEL=gemma-4-e4b
# SIYA_VOICE_URL=http://127.0.0.1:8795
# SIYA_VOICE=
# SIYA_VOICE_SPEED=1.0

# Emotion read from the user's words (TypeSafe "Jev"). Text leaves the
# machine, so this is never used in local-brain mode. Set to "off" to disable.
# TYPESAFE_API_KEY=
# SIYA_TEXT_EMOTION=off

# Where memories, settings, logs and cognition state are stored.
# Defaults to the working directory (and ./.siya-data for cognition).
# SIYA_DATA_DIR=
# SIYA_COGNITION_DATA_DIR=

# Python desktop agent
# SIYA_PYTHON=python3
# DESKTOP_AGENT_URL=http://127.0.0.1:8765
# DESKTOP_OBSERVER_URL=http://127.0.0.1:8766

# Public-APIs catalogue sync for the API hub
# SIYA_API_CATALOGUE_SYNC=true
# SIYA_PUBLIC_APIS_URL=

# Optional generated-motion service (procedural gestures are used otherwise)
# SIYA_MOTION_SERVICE_URL=

# Packaging only: HTTPS directory that hosts release builds for auto-update
# SIYA_UPDATE_URL=
